# ============================================================
# Daily Robot Report 环境变量配置
# 本地运行前复制本文件为 .env：cp .env.example .env && chmod 600 .env
# 在 GitHub Actions 运行时，请将对应项填入仓库 Settings -> Secrets and variables -> Actions
# ============================================================

# ---------- 1. 大模型 API 配置 ----------
# 方案 A：Google Gemini 官方 API（GitHub Actions 默认推荐，海外节点直连）
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# 使用 GEMINI_API_KEY（AQ. 或 AIza 开头均可）时默认自动匹配 gemini-3.8-flash，并在高峰 503 时自动回退到 gemini-3.5-flash-lite；如需覆盖取消注释：
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_FILTER_MODEL=gemini-3.8-flash
# LLM_DEEP_MODEL=gemini-3.8-flash

# 方案 B：阿里云百炼 DashScope / DeepSeek / OpenAI 等兼容接口
# LLM_API_KEY=YOUR_LLM_API_KEY
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_FILTER_MODEL=qwen-plus
# LLM_DEEP_MODEL=qwen-plus

# ---------- 2. 飞书群机器人 Webhook（可选，建议与邮箱至少配一个）----------
FEISHU_WEBHOOK=YOUR_FEISHU_WEBHOOK_URL
# 如果飞书机器人开启了“签名校验”，填写密钥；未开启留空即可
FEISHU_SECRET=

# ---------- 3. 邮件 SMTP 推送配置（可选，支持 QQ/163/Gmail 等）----------
# 示例 A：QQ 邮箱（SSL 端口 465，密码填“QQ 邮箱授权码”而非登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=YOUR_EMAIL@qq.com
SMTP_PASSWORD=YOUR_SMTP_AUTH_CODE
EMAIL_FROM=YOUR_EMAIL@qq.com
# 支持逗号分隔多个收件人
EMAIL_TO=YOUR_EMAIL@qq.com

# 示例 B：Gmail（STARTTLS 端口 587，密码填 App Password 应用专用密码）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_SSL=false

# ---------- 4. 静态网页访问基地址（可选）----------
# 在 GitHub Actions 中若留空，程序会自动推导为 https://<你的用户名>.github.io/<仓库名>
# PUBLIC_BASE_URL=https://<your-username>.github.io/<your-repo>
